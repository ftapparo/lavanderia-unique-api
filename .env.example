# Environment
NODE_ENV=production

# Port mapping
CONTAINER_PORT=3031
API_PORT=3000

# Database connection (API uses DATABASE_URL)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=unique_db
DATABASE_USER=unique_db_user
DATABASE_URL=postgres://unique_db_user:<password>@postgres:5432/unique_db

# Secrets (set in Portainer stack variables)
JWT_SECRET=<strong-secret>
POSTGRES_PASSWORD=<db-password>

# Auth settings
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Billing settings
BILLING_MODE=PER_USE
PRICE_PER_USE=0
PRICE_PER_KWH=0

# Check-in settings
CHECKIN_WINDOW_BEFORE_MINUTES=15
CHECKIN_WINDOW_AFTER_MINUTES=30

# Jobs (Sprint 4)
JOBS_ENABLED=true
JOB_NO_SHOW_CRON=*/2 * * * *
JOB_RESERVATION_END_CRON=* * * * *
JOB_OVERTIME_MONITOR_CRON=* * * * *
JOB_MONTHLY_BILLING_CRON=5 0 1 * *

# Billing report e-mail (Sprint 4)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=lavanderia@condominiounique.com.br
EMAIL_PASS=senha_aqui
EMAIL_FROM=Lavanderia Unique <lavanderia@condominiounique.com.br>
BILLING_REPORT_TO=gerente@condominiounique.com.br

# Tuya integration (API -> TUYA service)
TUYA_SERVICE_BASE_URL=http://tuya:3001
TUYA_MOCK_MODE=true
TUYA_TIMEOUT_MS=5000
TUYA_RETRY_ATTEMPTS=3
TUYA_RETRY_BASE_DELAY_MS=250

# Timezone (DB container)
TZ=America/Sao_Paulo
PGTZ=America/Sao_Paulo
