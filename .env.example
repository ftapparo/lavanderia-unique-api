# Variáveis de ambiente para o projeto Unique
NODE_ENV=

# Configurações de porta
CONTAINER_PORT=
API_PORT=

# Configuração do banco de dados
DATABASE_HOST=
DATABASE_PORT=
DATABASE_DB=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=

# Configurações de autenticação
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Configurações de cobrança
BILLING_MODE=PER_USE
PRICE_PER_USE=0
PRICE_PER_KWH=0

# Configurações de check-in
CHECKIN_TOLERANCE_MINUTES=30

