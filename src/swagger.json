{
  "openapi": "3.0.1",
  "info": {
    "title": "Lavanderia Unique API",
    "description": "API para autenticação, gestão de unidades e vínculos de unidade do sistema de lavanderia condominial. Todos os endpoints utilizam os headers x-request-id (correlação) e x-actor (ator), e os retornam na resposta quando disponíveis.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Endpoints de verificação de disponibilidade da API."
    },
    {
      "name": "Autenticação",
      "description": "Endpoints de cadastro, login, renovação de token e usuário autenticado."
    },
    {
      "name": "Unidades",
      "description": "Endpoints para consulta e criação de unidades residenciais."
    },
    {
      "name": "Vínculos de Unidade",
      "description": "Endpoints para consultar, criar e atualizar vínculos entre usuários e unidades."
    }
  ],
  "paths": {
    "/v1/api/health": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "summary": "Verificar saúde da API",
        "description": "Retorna o status de funcionamento da API e o ambiente de execução atual.",
        "responses": {
          "200": {
            "description": "API disponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHealth"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/healthcheck": {
      "get": {
        "tags": [
          "Saúde"
        ],
        "summary": "Verificar saúde da API (alias)",
        "description": "Alias de health check para compatibilidade com monitoramento e integracoes legadas.",
        "responses": {
          "200": {
            "description": "API disponível.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseHealth"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/register": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Cadastrar novo usuário",
        "description": "Cria uma nova conta de usuário e retorna tokens de autenticação junto com o perfil cadastrado.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário cadastrado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuth"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Autenticar usuário",
        "description": "Autentica por e-mail ou CPF e retorna access token, refresh token e dados do usuário.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticação realizada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseAuth"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/refresh": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Renovar tokens",
        "description": "Recebe um refresh token válido e retorna novos tokens de autenticação.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens renovados com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseRefresh"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/me": {
      "get": {
        "tags": [
          "Autenticação"
        ],
        "summary": "Obter usuário autenticado",
        "description": "Retorna os dados do usuário associado ao access token enviado no cabecalho Authorization.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do usuário autenticado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUser"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/units": {
      "get": {
        "tags": [
          "Unidades"
        ],
        "summary": "Listar unidades",
        "description": "Retorna a lista de unidades disponíveis para o usuário autenticado.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de unidades retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUnits"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Unidades"
        ],
        "summary": "Criar unidade",
        "description": "Cria uma nova unidade residencial. Endpoint restrito a usuários com perfil administrador.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnitRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Unidade criada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseUnit"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/unit-memberships": {
      "get": {
        "tags": [
          "Vínculos de Unidade"
        ],
        "summary": "Listar vínculos de unidade",
        "description": "Retorna os vínculos entre usuários e unidades de acordo com as permissões do usuário autenticado.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de vínculos retornada com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMemberships"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Vínculos de Unidade"
        ],
        "summary": "Criar vinculo de unidade",
        "description": "Cria um vínculo entre usuário e unidade com perfil e período de vigência. Endpoint restrito a administradores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMembershipRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Vinculo criado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMembership"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/api/unit-memberships/{id}": {
      "patch": {
        "tags": [
          "Vínculos de Unidade"
        ],
        "summary": "Atualizar vinculo de unidade",
        "description": "Atualiza os dados de um vinculo de unidade existente. Endpoint restrito a administradores.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Identificador do vínculo de unidade.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMembershipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vinculo atualizado com sucesso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseMembership"
                }
              }
            },
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "Obter especificacao OpenAPI",
        "description": "Retorna o documento OpenAPI em formato JSON.",
        "responses": {
          "200": {
            "description": "Especificacao retornada com sucesso.",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/RequestIdHeader"
              },
              "x-actor": {
                "$ref": "#/components/headers/ActorHeader"
              }
            }
          }
        },
        "tags": [
          "Saúde"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponseBase": {
        "type": "object",
        "description": "Envelope padrão de resposta da API.",
        "properties": {
          "data": {
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "nullable": true
          }
        }
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "type": "string"
          }
        }
      },
      "AuthData": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "RefreshData": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "Unit": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "Membership": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "unitId": {
            "type": "string"
          },
          "unitName": {
            "type": "string"
          },
          "unitCode": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "endDate": {
            "type": "string",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "name",
          "cpf",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "identity",
          "password"
        ],
        "properties": {
          "identity": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "CreateUnitRequest": {
        "type": "object",
        "required": [
          "name",
          "code"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "CreateMembershipRequest": {
        "type": "object",
        "required": [
          "userId",
          "unitId",
          "profile",
          "startDate"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "unitId": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "UpdateMembershipRequest": {
        "type": "object",
        "properties": {
          "profile": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "ApiResponseHealth": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/HealthData"
              }
            }
          }
        ]
      },
      "ApiResponseAuth": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/AuthData"
              }
            }
          }
        ]
      },
      "ApiResponseRefresh": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/RefreshData"
              }
            }
          }
        ]
      },
      "ApiResponseUser": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        ]
      },
      "ApiResponseUnit": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Unit"
              }
            }
          }
        ]
      },
      "ApiResponseUnits": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Unit"
                }
              }
            }
          }
        ]
      },
      "ApiResponseMembership": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Membership"
              }
            }
          }
        ]
      },
      "ApiResponseMemberships": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ApiResponseBase"
          },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          }
        ]
      }
    },
    "headers": {
      "RequestIdHeader": {
        "description": "Identificador único da requisição para rastreabilidade (x-request-id).",
        "schema": {
          "type": "string",
          "example": "f25f63b8-2b89-4fc0-8a2e-7b2e8c7d6f53"
        }
      },
      "ActorHeader": {
        "description": "Ator identificado para a requisição (x-actor).",
        "schema": {
          "type": "string",
          "example": "SWAGGER"
        }
      }
    }
  }
}
