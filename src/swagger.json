{
  "openapi": "3.0.1",
  "info": {
    "title": "Template API",
    "description": "API base para novos projetos.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "/" }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Units" },
    { "name": "UnitMemberships" }
  ],
  "paths": {
    "/v1/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseHealth" }
              }
            }
          }
        }
      }
    },
    "/v1/api/healthcheck": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check alias",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseHealth" }
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RegisterRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseAuth" }
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseAuth" }
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseRefresh" }
              }
            }
          }
        }
      }
    },
    "/v1/api/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseUser" }
              }
            }
          }
        }
      }
    },
    "/v1/api/units": {
      "get": {
        "tags": ["Units"],
        "summary": "List units",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseUnits" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Units"],
        "summary": "Create unit (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUnitRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseUnit" }
              }
            }
          }
        }
      }
    },
    "/v1/api/unit-memberships": {
      "get": {
        "tags": ["UnitMemberships"],
        "summary": "List memberships",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMemberships" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["UnitMemberships"],
        "summary": "Create membership (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateMembershipRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMembership" }
              }
            }
          }
        }
      }
    },
    "/v1/api/unit-memberships/{id}": {
      "patch": {
        "tags": ["UnitMemberships"],
        "summary": "Update membership (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateMembershipRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponseMembership" }
              }
            }
          }
        }
      }
    },
    "/v1/openapi.json": {
      "get": {
        "summary": "OpenAPI",
        "responses": { "200": { "description": "OK" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponseBase": {
        "type": "object",
        "properties": {
          "data": { "nullable": true },
          "message": { "type": "string", "nullable": true },
          "errors": { "nullable": true }
        }
      },
      "HealthData": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "environment": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "cpf": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "role": { "type": "string" }
        }
      },
      "AuthData": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "RefreshData": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" }
        }
      },
      "Unit": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "Membership": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "userId": { "type": "string" },
          "unitId": { "type": "string" },
          "unitName": { "type": "string" },
          "unitCode": { "type": "string" },
          "profile": { "type": "string" },
          "startDate": { "type": "string" },
          "endDate": { "type": "string", "nullable": true },
          "active": { "type": "boolean" }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": ["name", "cpf", "email", "password"],
        "properties": {
          "name": { "type": "string" },
          "cpf": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identity", "password"],
        "properties": {
          "identity": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": { "type": "string" }
        }
      },
      "CreateUnitRequest": {
        "type": "object",
        "required": ["name", "code"],
        "properties": {
          "name": { "type": "string" },
          "code": { "type": "string" }
        }
      },
      "CreateMembershipRequest": {
        "type": "object",
        "required": ["userId", "unitId", "profile", "startDate"],
        "properties": {
          "userId": { "type": "string" },
          "unitId": { "type": "string" },
          "profile": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date", "nullable": true },
          "active": { "type": "boolean" }
        }
      },
      "UpdateMembershipRequest": {
        "type": "object",
        "properties": {
          "profile": { "type": "string" },
          "startDate": { "type": "string", "format": "date" },
          "endDate": { "type": "string", "format": "date", "nullable": true },
          "active": { "type": "boolean" }
        }
      },
      "ApiResponseHealth": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/HealthData" }
            }
          }
        ]
      },
      "ApiResponseAuth": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/AuthData" }
            }
          }
        ]
      },
      "ApiResponseRefresh": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/RefreshData" }
            }
          }
        ]
      },
      "ApiResponseUser": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/User" }
            }
          }
        ]
      },
      "ApiResponseUnit": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/Unit" }
            }
          }
        ]
      },
      "ApiResponseUnits": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Unit" }
              }
            }
          }
        ]
      },
      "ApiResponseMembership": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": { "$ref": "#/components/schemas/Membership" }
            }
          }
        ]
      },
      "ApiResponseMemberships": {
        "allOf": [
          { "$ref": "#/components/schemas/ApiResponseBase" },
          {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/Membership" }
              }
            }
          }
        ]
      }
    }
  }
}
